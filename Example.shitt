def Id2OEq : {A : U} {a b : A} -> Id a b -> a ~ b
| (refl _) = rfl _

def addCommO : {a b : Nat} -> (add a b) ~ (add b a) = Id2OEq addComm

def vEq : {a b : Nat} -> (Vec Bool (add a b)) ~ (Vec Bool (add b a)) = apd (Vec Bool) addCommO

def T : (a b : Nat) -> I -> U
| a b i0 = Vec Bool (add a b)
| a b i1 = Vec Bool (add b a)

def apd for T
| (T a b) seg = vEq

def replicate : (n : Nat) -> Vec Bool n
| zero = vnil
| (suc n) = vcons true (replicate n)

def t : {a b : Nat} (i : I) -> T a b i 
| {a} {b} i0 = replicate (add a b)
| {a} {b} i1 = replicate (add b a)

def apd for t 
| (t {a} {b}) seg = sorry -- with proof-irrelevenc, here should be smth like: apd replicate addCommO


