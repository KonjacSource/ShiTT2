mutual
  data AA : U
  data BB : AA -> U
begin

  data AA  
  | a : AA

  data BB  
  | b : BB a

  data AA  
  | f : BB a -> AA

  data AA
  | g : BB (f b) -> AA

  data BB  
  | h : (x : BB a) -> BB (f x)

end

-- As axioms
def AAM : AA -> U
def BBM : {x : AA} -> AAM x -> BB x -> U
def aM : AAM a
def fM : {x : BB a} -> BBM aM x -> AAM (f x)
def bM : BBM aM b
def gM : {x : BB (f b)} -> BBM (fM bM) x -> AAM (g x)
def hM : {x : BB a} (xM : BBM aM x) -> BBM (fM xM) (h x)

mutual 

  def elimA : (x : AA) -> AAM x
  def elimB : {x : AA} (y : BB x) -> BBM (elimA x) y

begin

  def elimA
  | a = aM
  def elimB 
  | b = bM
  
  def elimA 
  | (f x) = fM (elimB x)

  def elimA
  | (g x) = gM (elimB x) 

  def elimB
  | (h y) = hM (elimB y)

end

